# Conda environment files (excluding environment.yml, which should be tracked)
*.egg-info/
__pycache__/
*.pyc

# Jupyter notebook checkpoints
.ipynb_checkpoints/
# Ignore all Jupyter notebooks by default
*.ipynb

# Explicitly include specific notebooks to track
!wavenotebooks/fremvisning.ipynb
!wavenotebooks/finebilde.ipynb

# Data folders (large CSV files)
wavedata/raw/
pressuredata/
#waveresults/
wavezarchive/
repl/

# Processed cache (binary/large — regenerated by main.py)
waveprocessed/
pre_pipline_eta_change_waveprocessed_folder/

# Runtime caption cache (rewritten on every main_save_figures.py import;
# source of truth is FIGURE_CAPTIONS dict in main_save_figures.py).
output/.figure_captions.json
# Sister cache for the table orchestrator (main_save_tables.py).
output/.table_captions.json

# Temporary files
*.log
*.tmp
*.bak

# macOS-specific
.DS_Store

# environment
.env

# Claude Code per-project state (settings, worktree metadata) — per-machine
.claude/
